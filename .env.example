# Servidor
PORT=3000

# CORS (origen permitido del frontend)
CORS_ORIGIN=http://localhost:4200

# JWT (cambiar los secretos fuera de desarrollo)
JWT_SECRET=cambiar-secreto-de-acceso
JWT_REFRESH_SECRET=cambiar-secreto-de-refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Base de datos (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=api_san
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# pgAdmin (http://localhost:5050)
PGADMIN_EMAIL=admin@apisan.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
